# inflect - slugs, plurals, ordinals and identifier cases, in pure Ecko.
#
# The shapes a CMS needs between a human title and a machine name:
#
#   import inflect
#
#   inflect.slug("Introducing Ecko 0.10!")   # "introducing-ecko-0-10"
#   inflect.plural("post")                    # "posts"
#   inflect.pluralize(3, "person")            # "3 people"
#   inflect.ordinal(21)                       # "21st"
#   inflect.snake("HelloWorld")               # "hello_world"
#
# Pure computation - no capabilities.
# `fail`, `is_alpha`, `is_digit` and `is_upper` stay exported by words.ecko so
# slug.ecko, english.ecko and cases.ecko can reach them, but they are internal
# character plumbing - a blanket `export *` would publish them as `inflect.*`.
export { words, capitalize } from "./words.ecko"
export * from "./slug.ecko"
export * from "./english.ecko"
export * from "./cases.ecko"
