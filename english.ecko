# English pluralisation, singularisation and ordinals.
#
# Mostly rules with a stubborn tail of exceptions. The exceptions are listed
# first and win, because trying to derive "people" from "person" is how these
# libraries end up producing "persons".

import std.str as str
import "./words.ecko"

## Words whose plural is the same as their singular. Applying a rule to any of
## these produces "sheeps" or "informations".
export fn uncountable() {
    [
        "sheep",
        "fish",
        "series",
        "species",
        "deer",
        "moose",
        "swine",
        "bison",
        "salmon",
        "trout",
        "aircraft",
        "spacecraft",
        "offspring",
        "information",
        "equipment",
        "money",
        "software",
        "hardware",
        "furniture",
        "luggage",
        "news",
        "advice",
        "music",
        "research",
        "evidence",
        "traffic",
    ]
}

## Irregular singular-to-plural pairs, in one direction; `singular` reverses
## this table rather than keeping a second one that could drift out of step.
export fn irregular() {
    {
        person: "people",
        child: "children",
        man: "men",
        woman: "women",
        tooth: "teeth",
        foot: "feet",
        goose: "geese",
        mouse: "mice",
        louse: "lice",
        ox: "oxen",
        die: "dice",
        penny: "pence",
        cactus: "cacti",
        focus: "foci",
        fungus: "fungi",
        nucleus: "nuclei",
        syllabus: "syllabi",
        analysis: "analyses",
        crisis: "crises",
        thesis: "theses",
        datum: "data",
        medium: "media",
        criterion: "criteria",
        phenomenon: "phenomena",
    }
}

## Words ending in -f or -fe that do NOT take -ves. English has both, and the
## rule alone would give "rooves" and "chiefs" the same treatment.
export fn keeps_f() {
    ["roof", "proof", "chief", "belief", "chef", "cliff", "reef", "safe", "gulf", "dwarf"]
}

## Words ending in -o that take -es. Most take a plain -s (photos, pianos), so
## the shorter list is the exceptional one.
export fn o_takes_es() {
    ["hero", "potato", "tomato", "echo", "veto", "torpedo", "embargo", "volcano", "mosquito"]
}

## Is this a vowel?
export fn is_vowel(c) = contains(["a", "e", "i", "o", "u"], str.lower(c))

## The last `n` characters of a word.
export fn tail(word, n) {
    cs = chars(word)
    if len(cs) < n { return word }
    join(drop(cs, len(cs) - n), "")
}

## Everything but the last `n` characters.
export fn head(word, n) {
    cs = chars(word)
    if len(cs) < n { return "" }
    join(take(cs, len(cs) - n), "")
}

## Re-apply the casing of `original` to `result`: a leading capital stays a
## leading capital, and an all-caps word stays all-caps. A CMS pluralises
## headings and route names, so "Post" must not come back as "posts".
export fn match_case(original, result) {
    cs = chars(original)
    if len(cs) == 0 { return result }
    if original == str.upper(original) and len(cs) > 1 { return str.upper(result) }
    if words.is_upper(cs[0]) { return words.capitalize(result) }
    result
}

## The plural of a word. Case is preserved.
export fn plural(word) {
    lower = str.lower(string(word))
    if lower == "" { return string(word) }
    if contains(uncountable(), lower) { return string(word) }
    found = get(irregular(), lower)
    unless is_null(found) { return match_case(string(word), found) }
    match_case(string(word), plural_rule(lower))
}

## The regular rules, applied to an already-lowercased word.
export fn plural_rule(w) {
    # -s, -x, -z, -ch, -sh take -es: buses, boxes, churches.
    if tail(w, 2) == "ch" or tail(w, 2) == "sh" { return w + "es" }
    if tail(w, 1) == "z" { return w + "zes" }
    if contains(["s", "x"], tail(w, 1)) { return w + "es" }
    # consonant + y becomes -ies; vowel + y just takes -s (days, not daies).
    if tail(w, 1) == "y" and len(chars(w)) > 1 and is_vowel(tail(head(w, 1), 1)) == false {
        return head(w, 1) + "ies"
    }
    if tail(w, 2) == "fe" and contains(keeps_f(), w) == false { return head(w, 2) + "ves" }
    if tail(w, 1) == "f" and contains(keeps_f(), w) == false { return head(w, 1) + "ves" }
    if tail(w, 1) == "o" and contains(o_takes_es(), w) { return w + "es" }
    w + "s"
}

## The singular of a word. Case is preserved.
export fn singular(word) {
    lower = str.lower(string(word))
    if lower == "" { return string(word) }
    if contains(uncountable(), lower) { return string(word) }
    for (one, many) in irregular() {
        if many == lower { return match_case(string(word), one) }
    }
    match_case(string(word), singular_rule(lower))
}

## The regular rules in reverse.
export fn singular_rule(w) {
    if tail(w, 3) == "ies" and len(chars(w)) > 3 { return head(w, 3) + "y" }
    if tail(w, 3) == "ves" {
        stem = head(w, 3)
        # knives -> knife, wolves -> wolf. The -fe words end in a consonant the
        # -f words do not, so try the -fe form only where it reads.
        if contains(["kni", "li", "wi"], stem) { return stem + "fe" }
        return stem + "f"
    }
    if tail(w, 4) == "zzes" { return head(w, 3) }
    if tail(w, 3) == "ses" or tail(w, 3) == "xes" { return head(w, 2) }
    if tail(w, 4) == "ches" or tail(w, 4) == "shes" { return head(w, 2) }
    if tail(w, 3) == "oes" { return head(w, 2) }
    if tail(w, 1) == "s" and tail(w, 2) != "ss" { return head(w, 1) }
    w
}

## "1 post" / "2 posts". The number is included; `word_for` gives just the word.
export fn pluralize(count, word) {
    string(count) + " " + word_for(count, word)
}

## The right form of `word` for `count`, without the number.
export fn word_for(count, word) {
    if count == 1 or count == 0 - 1 { singular(word) } else { plural(word) }
}

## ordinal(21) -> "21st".
##
## The rule is not "look at the last digit": 11, 12 and 13 take "th" despite
## ending in 1, 2 and 3. That trap is the whole reason this function exists.
export fn ordinal(n) {
    sign = if n < 0 { "-" } else { "" }
    magnitude = if n < 0 { 0 - n } else { n }
    last_two = magnitude % 100
    last_one = magnitude % 10
    suffix = if last_two >= 11 and last_two <= 13 { "th" } else {
        if last_one == 1 {
            "st"
        } else {
            if last_one == 2 { "nd" } else { if last_one == 3 { "rd" } else { "th" } }
        }
    }
    sign + string(magnitude) + suffix
}
